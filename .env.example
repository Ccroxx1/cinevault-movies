# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The public URL where this app is hosted (e.g., https://cinevault.vercel.app).
APP_URL="http://localhost:3000"

# UPSTASH_REDIS: Persistent cloud database for visitor analytics
# Get these from your Upstash console: https://console.upstash.com/
UPSTASH_REDIS_REST_URL="https://your-database-id.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_rest_token_here"
