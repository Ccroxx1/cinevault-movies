{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/**"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(index.html)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(sw.js|registerSW.js|manifest.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/movies/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=120, stale-while-revalidate=300"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; font-src 'self' data: https:; img-src 'self' data: blob: https:; connect-src 'self' https:; frame-src 'self' https:; worker-src 'self' blob:; manifest-src 'self'"
        }
      ]
    },
    {
      "source": "/(robots.txt|sitemap.xml|ads.txt|google.*.html|BingSiteAuth.xml|og-image.jpg|.*.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/ads.txt",
      "destination": "https://srv.adstxtmanager.com/85131/moviesandseries.xyz",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/poster",
      "destination": "/api/index"
    },
    {
      "source": "/api/poster/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/image-proxy",
      "destination": "/api/index"
    },
    {
      "source": "/api/proxy/image",
      "destination": "/api/index"
    },
    {
      "source": "/api/movies/poster",
      "destination": "/api/index"
    },
    {
      "source": "/api/tv/poster",
      "destination": "/api/index"
    },
    {
      "source": "/api/tv/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/tv",
      "destination": "/api/index"
    },
    {
      "source": "/api/eztv/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/eztv",
      "destination": "/api/index"
    },
    {
      "source": "/api/cinebot/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/cinebot",
      "destination": "/api/index"
    },
    {
      "source": "/api/health",
      "destination": "/api/index"
    },
    {
      "source": "/api/visitors/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/movies/filmography",
      "destination": "/api/index"
    },
    {
      "source": "/api/movies",
      "destination": "/api/index"
    },
    {
      "source": "/api/movies/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/v2/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/download/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/movies/:slug",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/api/index"
    }
  ],
  "buildCommand": "npm run build"
}
