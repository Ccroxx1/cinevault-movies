{
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/ads.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/movies/list",
      "destination": "https://movies-api.accel.li/api/v2/list_movies.json"
    },
    {
      "source": "/api/movies/details",
      "destination": "https://movies-api.accel.li/api/v2/movie_details.json"
    },
    {
      "source": "/api/movies/suggestions",
      "destination": "https://movies-api.accel.li/api/v2/movie_suggestions.json"
    },
    {
      "source": "/api/movies/parental_guides",
      "destination": "https://movies-api.accel.li/api/v2/movie_parental_guides.json"
    },
    {
      "source": "/api/v2/(.*)",
      "destination": "https://movies-api.accel.li/api/v2/$1"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/ads.txt",
      "destination": "/ads.txt"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
